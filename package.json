{
    "name": "ops-pilot",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
        "arena": "node --env-file-if-exists=.env --import tsx src/arena.ts",
        "bench": "node --env-file-if-exists=.env --import tsx src/bench.ts",
        "mcp": "tsx src/mcp/server.ts",
        "test": "node --import tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
        "typecheck": "tsc && tsc -p web/tsconfig.app.json",
        "seed:demo": "node --import tsx src/scripts/seed-demo.ts",
        "dev:web": "vite --config web/vite.config.ts",
        "build:web": "vite build --config web/vite.config.ts",
        "preview:web": "vite preview --config web/vite.config.ts"
    },
    "dependencies": {
        "@huggingface/transformers": "^4.3.1",
        "@langchain/core": "^1.2.17",
        "@langchain/langgraph": "^1.5.0",
        "@langchain/openai": "^1.6.2",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "js-tiktoken": "^1.0.21",
        "mysql2": "^3.24.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sequelize": "^6.37.8",
        "umzug": "^3.8.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sequelize": "^4.28.20",
        "@vitejs/plugin-react": "^6.3.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
}
